<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= pageTitle %></title>
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
    rel="stylesheet"
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
    crossorigin="anonymous"
  >
</head>

<body class="bg-body-tertiary min-vh-100">
  <header class="bg-dark text-white border-bottom border-primary border-4 py-5">
    <div class="container">
      <p class="text-info text-uppercase fw-semibold small mb-2">
        Secure classroom tool
      </p>

      <h1 class="display-5 fw-bold mb-2">
        <%= pageTitle %>
      </h1>

      <p class="lead text-white-50 mb-0">
        A secure place to create, organize, and manage your notes.
      </p>
    </div>
  </header>

  <main class="container py-4 py-lg-5">
    <section class="card border-0 shadow-sm mb-4">
      <div
        class="card-body d-flex flex-column flex-md-row
               justify-content-between align-items-md-center gap-3"
      >
        <% if (isAuthenticated) { %>
          <div>
            <p class="text-body-secondary small mb-1">
              Current user
            </p>

            <p class="fw-semibold mb-0">
              <%= user.name || user.email || user.nickname %>
            </p>
          </div>

          <nav class="d-flex flex-wrap gap-2">
            <a class="btn btn-outline-primary btn-sm" href="/profile">
              View Profile
            </a>

            <a class="btn btn-outline-secondary btn-sm" href="/logout">
              Log Out
            </a>
          </nav>
        <% } else { %>
          <div>
            <h2 class="h5 mb-1">Welcome to the Note-Taking App</h2>

            <p class="text-body-secondary mb-0">
              Sign in to create and manage your notes.
            </p>
          </div>

          <nav class="d-flex flex-wrap gap-2">
            <a class="btn btn-primary" href="/signup">
              Sign Up
            </a>

            <a class="btn btn-outline-primary" href="/login">
              Log In
            </a>
          </nav>
        <% } %>
      </div>
    </section>

    <% if (isAuthenticated) { %>
      <div class="row g-4 align-items-start">
        <div class="col-lg-5">
          <section class="card border-0 shadow-sm">
            <div class="card-body p-4">
              <h2 id="form-heading" class="h4 mb-1">
                Create a Note
              </h2>

              <p class="text-body-secondary small mb-4">
                Enter a title and the information you want to save.
              </p>

              <form
                id="note-form"
                action="/api/notes"
                method="POST"
                class="vstack gap-3"
              >
                <div>
                  <label class="form-label fw-semibold" for="title">
                    Title
                  </label>

                  <input
                    class="form-control"
                    type="text"
                    id="title"
                    name="title"
                    maxlength="100"
                    placeholder="Enter a note title"
                    required
                  >
                </div>

                <div>
                  <label class="form-label fw-semibold" for="content">
                    Note
                  </label>

                  <textarea
                    class="form-control"
                    id="content"
                    name="content"
                    rows="8"
                    maxlength="5000"
                    placeholder="Enter your note"
                    required
                  ></textarea>
                </div>

                <div class="d-grid d-sm-flex gap-2">
                  <button
                    id="save-note-button"
                    class="btn btn-primary flex-grow-1"
                    type="submit"
                  >
                    Save Note
                  </button>

                  <button
                    id="cancel-edit-button"
                    class="btn btn-outline-secondary"
                    type="button"
                    hidden
                  >
                    Cancel Edit
                  </button>
                </div>
              </form>

              <p
                id="note-message"
                class="fw-semibold mt-3 mb-0"
                role="status"
                aria-live="polite"
              ></p>
            </div>
          </section>
        </div>

        <div class="col-lg-7">
          <section class="card border-0 shadow-sm">
            <div class="card-body p-4">
              <div class="mb-4">
                <h2 class="h4 mb-1">Your Notes</h2>

                <p class="text-body-secondary small mb-0">
                  Review, edit, or delete your saved notes.
                </p>
              </div>

              <div id="notes-list" class="vstack gap-3">
                <div class="alert alert-secondary mb-0">
                  Loading notes...
                </div>
              </div>
            </div>
          </section>
        </div>
      </div>
    <% } %>
  </main>

  <footer class="container pb-4 text-center">
    <p class="text-body-secondary small mb-0">
      Built with Node.js, Express, MongoDB, Auth0, and Bootstrap.
    </p>
  </footer>

  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
    crossorigin="anonymous"
  ></script>

  <% if (isAuthenticated) { %>
    <script src="/js/notes.js"></script>
  <% } %>
</body>
</html>